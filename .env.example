# Servidor
PORT=7777
ANTHROPIC_API_KEY=

# Solo para desarrollo local: a dónde apuntan los hooks
PEAJE_SERVER_URL=http://localhost:7777

# Modo demo: 1 segundo real = N segundos simulados
PEAJE_DEMO_SPEED=60

# Voz. Sin estas variables el widget usa el speechSynthesis del navegador.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5
# Rate limits: ráfagas por token y presupuesto global de caracteres por hora
ELEVENLABS_RPM=20
ELEVENLABS_CHARS_HOUR=8000
